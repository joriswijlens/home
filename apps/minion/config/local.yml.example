# Copy to local.yml for a laptop run — gitignored, and loaded last so it wins.
# Overrides the deployment's absolute paths; nothing else needs to change.
store:
  db_path: "./minion.db"

tools:
  allowed_paths:
    - /tmp
  git_repos:
    - .

github:
  repo: ""          # set to owner/name to poll, leave empty to run the API only

# Webhook secrets — better via env (MINION_WEBHOOKS__SECRETS__HA=...) than on disk.
# A source without one refuses to start: an open /hooks route runs the agent, which
# spends money and executes shell and git tools.
# webhooks:
#   secrets:
#     ha: "generate-with-openssl-rand-hex-32"
#   allow_bearer: ["ha"]   # LAN senders that cannot sign; never for external ones
